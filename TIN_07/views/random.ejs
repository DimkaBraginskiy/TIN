<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Validator</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="wrapper" style="margin-top: 30px; padding: 20px; background: #f0f8ff; border-radius: 10px;">
        <h3>Live Data Updates</h3>
        <p><strong>Current Random Number:</strong> <span id="randomNumber">0</span></p>
        <p><strong>Last Update:</strong> <span id="updateTime">Never</span></p>
        <button type="submit" onclick="startUpdates()">Start Updates</button>
        <button type="submit" onclick="stopUpdates()">Stop Updates</button>
    </div>

    <div class="footer">
        nice footer
    </div>

    <script src="/js/random.js"></script>

</body>
</html>