<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Vehicle List</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<h1>Vehicle List</h1>

<a href="/vehicles/add" class="add-btn">Add New Vehicle</a>


<table>
    <thead>
    <tr>
        <th>Model</th>
        <th>Year</th>
        <th>Price</th>
        <th>Brand</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    <% vehicles.forEach(vehicle => { %>
        <tr>
            <td><%= vehicle.model %></td>
            <td><%= vehicle.year %></td>
            <td>$<%= vehicle.price.toLocaleString() %></td>
            <td><%= vehicle.brand_name %></td>
            <td>
                <a href="/vehicles/edit/<%= vehicle.id %>" class="button update-btn">Edit</a>
                <a href="/vehicles/delete/<%= vehicle.id %>" class="button delete-btn">Delete</a>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
</body>
</html>